# 사용법:
#   1) 이 파일을 복사해서 파일 이름을 ".env" 로 바꾼다 (앞의 점 포함).
#   2) 필요한 값을 채운다.
#   3) .env 는 절대 외부에 공유하거나 git에 올리지 않는다 (.gitignore로 이미 제외됨).

# ===== LLM 설정 =====
# 어떤 LLM을 쓸지 고른다: ollama (무료·로컬, 기본)  또는  claude (유료·API)
LLM_PROVIDER=ollama

# --- Ollama를 쓸 때 ---
# 미리 `ollama pull <모델명>` 으로 받아둔 모델 이름을 적는다.
#   llama3.2      : 3B, 가볍고 빠름. 한국어는 보통 수준.
#   llama3.2:1b   : 1B, PC 사양이 낮을 때. 품질은 더 낮음.
#   qwen2.5:3b    : 3B, 한국어 성능이 llama3.2보다 나은 편. (한국어 문서라면 추천)
OLLAMA_MODEL=llama3.2

# --- 나중에 Claude와 비교할 때만 (지금은 그대로 두기) ---
# 위 LLM_PROVIDER 를 claude 로 바꾸고, 아래 키를 채운다.
# 키 발급: https://console.anthropic.com  ->  Settings  ->  API Keys
CLAUDE_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-여기에-본인-키
